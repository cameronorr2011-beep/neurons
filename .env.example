# Pick at least one OpenAI-compatible provider.
NUMES_API_KEY=
NUMES_BASE_URL=https://api.numes.ai/api/v1
NUMES_MODEL=dealignai/deepseek-v4.1-flash-uncensored-fp8:free

# Optional second provider, used as the fallback before any tool runs.
LOGFARE_API_KEY=
LOGFARE_BASE_URL=https://logfare.ai/v1
LOGFARE_MODEL=logfare/auto

# Optional extra OpenAI-compatible provider.
NEURONS_API_KEY=
NEURONS_BASE_URL=
NEURONS_MODEL=
NEURONS_PROVIDER=numes
NEURONS_FALLBACK=logfare

# App paths. Leave workspace blank to use the app folder.
NEURONS_WORKSPACE=
NEURONS_DATA=./data
# NEURONS_ENV_FILE=C:/path/to/.env
# NEURONS_SKILLS=./.agents/skills
# NEURONS_MCP_CONFIG=./.mcp.json
